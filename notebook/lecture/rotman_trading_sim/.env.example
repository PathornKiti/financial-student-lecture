# ============================================================================
#  RIT connection — copy this file to `.env` and fill in RIT_API_KEY.
#      cp .env.example .env
#  `.env` is gitignored. Never commit your real key.
# ============================================================================

# ---- THE ONLY LINE YOU MUST FILL IN ----------------------------------------
# Get this from the RIT client: click the "API" icon on the BOTTOM BAR (bottom-right,
# next to RTD and API Orders). Note: "API Orders" - permission to SEND orders - is off
# by default except on ALGO cases, and is controlled by the server, not by you.
#   1. click the "API" icon on the bottom bar
#   2. read (or set) the API key shown in that panel
#   3. paste the same string here
#   4. check the "API Orders" icon is GREEN if you intend to trade; grey means
#      read-only and every order will be rejected - use tools/monitor.py instead
RIT_API_KEY=


# ---- WHERE THE RIT CLIENT IS ------------------------------------------------
# The REST API is served by the RIT *client* on your own machine, not by a
# Rotman server. So for a normal setup these defaults are already correct and
# you do not touch them: you log the client into the competition server through
# its own login screen, and the client then exposes localhost:9999 to you.
RIT_HOST=localhost
RIT_PORT=9999

# Only if the client's API panel shows a different port.
# RIT_PORT=9998

# Escape hatch: set this to override HOST/PORT entirely.
# Use it to point at the offline simulator, or at a client on another machine.
# RIT_URL=http://localhost:9999/v1

# Almost always false — the local REST API is plain HTTP.
RIT_HTTPS=false


# ---- DMA REST API (the server-hosted alternative) --------------------------
# RIT has two REST APIs. They use DIFFERENT hosts AND DIFFERENT authentication:
#
#   CLIENT API  http://localhost:9999/v1        -> X-API-Key  (the key above)
#   DMA API     http://<server>:<dma-port>/v1   -> HTTP Basic with your RIT
#                                                  LOGIN trader ID + password
#
# The Client API needs the Windows RIT Client running on your machine.
# The DMA API talks straight to the RIT Instructor App and needs NO client -
# which is the only way to trade from macOS or Linux.
#
# Set RIT_DMA_URL and your login below, then run:
#     python tools/doctor.py --probe
# to see which of the two you can actually reach from this machine.
#
# To USE the DMA API, uncomment RIT_URL so it overrides host/port:
# RIT_URL=http://161.200.68.42:10002/v1

RIT_DMA_URL=http://161.200.68.42:10002/v1
RIT_TRADER_ID=
RIT_PASSWORD=


# ---- SAFETY -----------------------------------------------------------------
# true  = bots log their decisions and send NOTHING (start here, always)
# false = bots send real orders
RIT_DRY_RUN=true

# Seconds between API polls. Raise to 0.4 if you see HTTP 429 (rate limited).
RIT_INTERVAL=0.25

# Client-side throttle, seconds between requests. 0 = unthrottled.
# 0.1 keeps you near 10 req/s. Raise to 0.2 if you still see HTTP 429.
RIT_MIN_INTERVAL=0.0


# ---- FI2 (Coupon Govt Bonds) -------------------------------------------------
FI2_MAX_POS=5000          # per-security cap; check real limits with tools/doctor.py
FI2_MAX_ORDER=1000        # case maximum is 1,000 bonds per order
FI2_MIN_EDGE=0.02         # $ edge required ON TOP of the $0.02/bond commission
FI2_MM=false              # also rest two-sided quotes around fair value
FI2_MM_SIZE=500
FI2_MM_SPREAD=0.05


# ---- EV1 (Equity Valuation) --------------------------------------------------
EV1_MAX_POS=100000        # case limit is 100,000 shares net
EV1_MAX_ORDER=10000       # max shares per single order
EV1_MIN_EDGE=0.03         # $ mispricing required on top of the 1c/share fee
EV1_FULL_EDGE=0.25        # $ mispricing that justifies the maximum position
EV1_MM=false
EV1_MM_SIZE=2500
EV1_MM_SPREAD=0.10

# Fraction of EV1_MAX_POS usable when no quarter has reported yet.
# 0.35 = cautious (fair value has ~$1.00 of standard deviation with all four
# quarters still estimates). 1.0 = full size on pure estimates.
EV1_CONFIDENCE_FLOOR=0.35
